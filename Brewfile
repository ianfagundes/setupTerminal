# Brewfile — ferramentas do ambiente de terminal.
# Instala tudo com:  brew bundle --file=Brewfile
# (o install.sh já faz isso pra você)

# --- prompt ---
brew "starship"          # prompt rápido e configurável (config em dotfiles/config/starship.toml)

# --- diff / git ---
brew "git-delta"         # diff com syntax highlight, side-by-side, tema Dracula
brew "gh"                # GitHub CLI (usado como credential helper no gitconfig)
brew "git-lfs"           # Git Large File Storage

# --- navegação / busca ---
brew "fzf"               # fuzzy finder (Ctrl-T arquivos, Ctrl-R histórico, Alt-C dirs)
brew "zoxide"            # cd inteligente por frequência (substitui cd)
brew "fd"                # find moderno (alimenta o fzf)
brew "ripgrep"           # grep moderno (rg)

# --- listagem / leitura ---
brew "eza"               # ls moderno com ícones e git status
brew "bat"               # cat com syntax highlight (tema Dracula, config em dotfiles/config/bat)
brew "tree"              # árvore de diretórios

# --- ambiente / git TUI ---
brew "direnv"            # carrega .envrc por diretório
brew "lazygit"           # TUI de git (alias lg)

# --- realce do zsh ---
brew "zsh-autosuggestions"       # sugestões fantasma do histórico
brew "zsh-syntax-highlighting"   # realce de sintaxe na linha de comando
brew "zsh-completions"           # completions extras
